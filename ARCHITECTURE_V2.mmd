flowchart TB
    U["用户回复文件消息并 @机器人发送“归档”"]

    subgraph SA["技能 A：发起文件归档"]
        direction LR
        A03["A0–A3<br/>校验群聊指令<br/>按 parent_id 精确读取被回复消息"]
        A47["A4–A7<br/>查询唯一群映射<br/>校验文件并创建 selecting_file 请求"]
        A810["A8–A10<br/>组装 skill_input<br/>发送卡片 1 后结束"]
        C1["卡片 1<br/>确认文件或取消"]
        A03 --> A47 --> A810 --> C1
    end

    U --> A03
    C1 -. "trigger_skill：每次点击新启动一次技能 B" .-> B03

    subgraph SB["技能 B：处理卡片点击"]
        direction TB
        B03["B0–B3.1<br/>读取 4 个开始参数和点击人<br/>数组化 request_id、查 Base、校验状态"]
        ACTION{"B3.1 action 条件分支"}
        B03 --> ACTION

        ACTION -->|"choose_file / browse / back / return_folder"| B49["B4–B9<br/>准备并保存状态<br/>读取目录、保存白名单、发送卡片 2"]
        B49 --> C2["卡片 2<br/>浏览目录或使用当前目录"]

        ACTION -->|"choose_current_folder"| B1011["B10–B11<br/>保存 target_folder<br/>改为 waiting_confirm 并发送卡片 3"]
        B1011 --> C3["卡片 3<br/>最终确认、返回或取消"]

        ACTION -->|"cancel"| BCANCEL["写入 cancelled<br/>记录 completed_at 后结束"]

        ACTION -->|"confirm_upload"| B1219["B12–B19<br/>processing → 重查请求 → 下载<br/>重查映射与真实大小 → 上传 → 写回结果"]
        B1219 --> RESULT{"上传结果"}
        RESULT -->|"成功"| BS["写入 success<br/>result token / URL / size"]
        RESULT -->|"失败"| BF["写入 failed<br/>真实 error / completed_at"]
        BS --> C4["卡片 4：归档结果"]
        BF --> C4
    end

    C2 -. "下一次点击重新从 B0 开始" .-> B03
    C3 -. "下一次点击重新从 B0 开始" .-> B03
